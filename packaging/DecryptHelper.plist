<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      注入过滤器 (MobileSubstrate / ElleKit / libhooker 通用格式)。
      默认: 注入所有链接 UIKit 的 App(覆盖面最大, 符合"审计任意 App"的定位)。

      要缩小到单个目标 App, 把 com.apple.UIKit 换成目标 Bundle ID, 例如:
        <string>com.tencent.xin</string>
      多个目标就并列多个 <string>。改完重装 .deb 或直接编辑设备上的
        {jbroot}/Library/MobileSubstrate/DynamicLibraries/DecryptHelper.plist
      后 respring 生效。
    -->
    <key>Filter</key>
    <dict>
        <key>Bundles</key>
        <array>
            <string>com.apple.UIKit</string>
        </array>
    </dict>
</dict>
</plist>
