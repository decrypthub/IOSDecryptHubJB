<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.dh.server</string>
	<key>ProgramArguments</key>
	<array>
		<string>/var/jb/usr/bin/dh_server</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>UserName</key>
	<string>root</string>
	<key>StandardOutPath</key>
	<string>/var/jb/tmp/dh_server.log</string>
	<key>StandardErrorPath</key>
	<string>/var/jb/tmp/dh_server.log</string>
</dict>
</plist>
